{
  "name": "mt-tradeflow",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MT 通商 · TRADEFLOW — 外贸业务管理系统（纯静态 · 浏览器本地存储 · GitHub Pages）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:root": "tsc -b && vite build --base=/",
    "build:project": "tsc -b && vite build --base=/ForeignTradeManagementSystem/",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "deploy": "node scripts/deploy-user-site.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
