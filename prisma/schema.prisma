// MT 通商 · TRADEFLOW — 数据模型
//
// 两条硬约定：
//  1. 金额一律用整数「分」存（BigInt），汇率用 6 位小数的整数存。SQLite 没有真正的
//     DECIMAL，用浮点会让订单核算和退税凑不平账。展示层才格式化。
//  2. 只用 SQLite 与 MySQL 都支持的类型：不用 MySQL ENUM（状态存字符串 + 应用层枚举），
//     不用 Json（存 JSON 文本）。切换 MySQL 只需改下面的 provider 与 DATABASE_URL。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // 切 MySQL：把这里改成 "mysql"，并在 prisma.config.ts 里换成 MySQL adapter
  provider = "sqlite"
}

/// 系统用户。角色决定能进哪些模块，scope 决定看得到哪些行。
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  /// admin | sales | merchandiser | purchaser | finance | viewer
  role         String   @default("sales")
  team         String?
  /// self | team | all
  scope        String   @default("self")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  customers Customer[]
  pis       Pi[]
  shipments Shipment[]
  notes     ShipmentNote[]
  auditLogs AuditLog[]

  @@index([role])
}

/// 客户主档。中信保额度挂在这里。
model Customer {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  country            String
  contact            String?
  /// A | B | C
  creditLevel        String   @default("B")
  sinosureLimitCents BigInt   @default(0)
  sinosureUsedCents  BigInt   @default(0)
  currency           String   @default("USD")
  /// IANA 时区，用于「客户当地时间」提示
  timezone           String?
  note               String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  salesId String?
  sales   User?   @relation(fields: [salesId], references: [id], onDelete: SetNull)

  pis Pi[]

  @@index([salesId])
  @@index([country])
}

/// 开票主体（如「晓行天下」「供应链」）。同一套业务数据，只是开票主体不同。
model SellerEntity {
  id     String  @id @default(cuid())
  name   String  @unique
  taxNo  String?
  bank   String?
  active Boolean @default(true)

  pis         Pi[]
  taxInvoices TaxInvoice[]
}

/// PI 取号即建档，是全系统的主线索。
model Pi {
  id          String    @id @default(cuid())
  piNo        String    @unique
  signedOn    DateTime?
  currency    String    @default("USD")
  amountCents BigInt    @default(0)
  product     String?
  destination String?
  /// open | closed | archived
  status      String    @default("open")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesId        String?
  sales          User?         @relation(fields: [salesId], references: [id], onDelete: SetNull)
  sellerEntityId String?
  sellerEntity   SellerEntity? @relation(fields: [sellerEntityId], references: [id], onDelete: SetNull)

  costing     OrderCosting?
  shipments   Shipment[]
  taxInvoices TaxInvoice[]

  @@index([customerId])
  @@index([salesId])
  @@index([status])
}

/// 订单核算。成本超支自动进入复核。
model OrderCosting {
  id                String   @id @default(cuid())
  piId              String   @unique
  pi                Pi       @relation(fields: [piId], references: [id], onDelete: Cascade)
  purchaseCostCents BigInt   @default(0)
  freightCents      BigInt   @default(0)
  customsCents      BigInt   @default(0)
  bankCents         BigInt   @default(0)
  otherCents        BigInt   @default(0)
  receivableCents   BigInt   @default(0)
  payableCents      BigInt   @default(0)
  /// 利润率，基点（bp）。2104 = 21.04%，可为负。
  profitRateBp      Int      @default(0)
  /// draft | pending_review | confirmed
  reviewState       String   @default("draft")
  /// 未完结 | 已完结
  settleState       String   @default("未完结")
  costEstimated     Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

/// 跟单表一行 = 一个出运批次。
model Shipment {
  id           String   @id @default(cuid())
  batchNo      String   @unique
  /// 「第 4 批」这类分批标签
  batchLabel   String?
  country      String
  /// FOB-SH / DDU / CIF …
  term         String
  /// 海运 | 空运 | 陆运 | 快递
  mode         String   @default("海运")
  /// true = 整柜(FCL)，false = 拼柜(LCL，多一个「进仓」节点)
  fcl          Boolean  @default(true)
  containerNo  String?
  carrier      String?
  pod          String?
  /// 已放行 | 未放行 | 待报关
  releaseState String   @default("未放行")
  team         String?
  /// 冗余存一份最新动态，列表页免去关联查询
  latestNote   String?
  latestNoteOn DateTime?
  hasTodo      Boolean  @default(false)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  piId    String?
  pi      Pi?     @relation(fields: [piId], references: [id], onDelete: SetNull)
  salesId String?
  sales   User?   @relation(fields: [salesId], references: [id], onDelete: SetNull)

  milestones ShipmentMilestone[]
  notes      ShipmentNote[]

  @@index([piId])
  @@index([salesId])
  @@index([releaseState])
  @@index([archived])
}

/// 里程碑节点，一行一个。plannedOn 是计划，actualOn 是实际发生。
model ShipmentMilestone {
  id         String    @id @default(cuid())
  shipmentId String
  shipment   Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  /// 交期 | 装柜 | 进仓 | ATD | ETA
  kind       String
  /// 展示顺序
  seq        Int
  plannedOn  DateTime?
  actualOn   DateTime?

  @@unique([shipmentId, kind])
  @@index([shipmentId])
}

/// 动态是流水而不是单字段，这样才有历史可查。
model ShipmentNote {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  body       String
  happenedOn DateTime @default(now())
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([shipmentId, happenedOn])
}

/// 出口退税发票明细。piId 为空 = 未关联订单行。
model TaxInvoice {
  id            String    @id @default(cuid())
  /// YYYY-MM
  declareMonth  String
  batch         String    @default("001")
  buyer         String
  sellerName    String
  invoiceNo     String
  item          String
  qty           Int       @default(0)
  grossCents    BigInt    @default(0)
  netCents      BigInt    @default(0)
  taxCents      BigInt    @default(0)
  exportedOn    DateTime?
  customsNo     String?
  customsUsdCents BigInt  @default(0)
  createdAt     DateTime  @default(now())

  piId           String?
  pi             Pi?           @relation(fields: [piId], references: [id], onDelete: SetNull)
  sellerEntityId String?
  sellerEntity   SellerEntity? @relation(fields: [sellerEntityId], references: [id], onDelete: SetNull)

  @@index([declareMonth])
  @@index([piId])
  @@index([sellerEntityId])
}

/// 汇率。rateE6 = 汇率 × 1_000_000，例如 6.7392 存 6739200。
model FxRate {
  id       String   @id @default(cuid())
  base     String   @default("USD")
  quote    String   @default("CNY")
  /// market | custom
  kind     String   @default("market")
  rateE6   Int
  asOf     DateTime @default(now())

  @@index([base, quote, kind, asOf])
}

/// 所有写操作留痕。before/after 存 JSON 文本（避免用 Json 类型，两库都兼容）。
model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entity   String
  entityId String
  action   String
  before   String?
  after    String?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
}
